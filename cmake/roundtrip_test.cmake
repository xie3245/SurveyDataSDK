if(NOT DEFINED EXCHANGE_TOOL OR NOT DEFINED WORK_DIR)
  message(FATAL_ERROR "EXCHANGE_TOOL and WORK_DIR are required")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef token)
set(directory "${WORK_DIR}/${token}")
file(MAKE_DIRECTORY "${directory}")
set(app_a "${directory}/app-a.db")
set(app_b "${directory}/app-b.db")
set(offline_b "${directory}/app-b-second-checkout.db")

function(run expected)
  execute_process(COMMAND "${EXCHANGE_TOOL}" ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR "Command ${ARGN} returned ${result}, expected ${expected}\n${output}\n${errors}")
  endif()
  message(STATUS "${output}${errors}")
  set(last_output "${output}${errors}" PARENT_SCOPE)
endfunction()

run(0 seed "${app_a}")
run(0 export "${app_a}" app-a demo-batch "${directory}/checkout.json")
run(0 checkout "${app_b}" "${directory}/checkout.json")
run(0 append "${app_b}" demo-batch from-b 10 20 30)
run(0 return "${app_b}" "${directory}/checkout.json" "${directory}/returned.json")
run(0 apply "${app_a}" app-a "${directory}/returned.json")
run(0 show "${app_a}" demo-batch)
if(NOT last_output MATCHES "revision=2 observations=2" OR NOT last_output MATCHES "id=from-b")
  message(FATAL_ERROR "Successful round trip did not preserve the expected data")
endif()

run(0 export "${app_a}" app-a demo-batch "${directory}/second-checkout.json")
run(0 checkout "${offline_b}" "${directory}/second-checkout.json")
run(0 append "${offline_b}" demo-batch offline-point 40 50 60)
run(0 return "${offline_b}" "${directory}/second-checkout.json" "${directory}/stale-return.json")
run(0 append "${app_a}" demo-batch newer-in-a 70 80 90)
run(2 apply "${app_a}" app-a "${directory}/stale-return.json")
if(NOT last_output MATCHES "CONFLICT")
  message(FATAL_ERROR "Stale return did not report a conflict")
endif()
run(0 show "${app_a}" demo-batch)
if(NOT last_output MATCHES "revision=3 observations=3" OR NOT last_output MATCHES "id=newer-in-a" OR last_output MATCHES "id=offline-point")
  message(FATAL_ERROR "Rejected return changed the origin data")
endif()
message(STATUS "Round-trip files are in ${directory}")
